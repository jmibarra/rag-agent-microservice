# --- Configuración del LLM ---
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
LLM_PROVIDER=openai # opciones: openai | gemini

# --- Integraciones de Atlassian ---

## Confluence (Ingesta de Conocimiento)
CONFLUENCE_URL=https://tu-dominio.atlassian.net/wiki
CONFLUENCE_USERNAME=nombre@ejemplo.com
CONFLUENCE_API_TOKEN=ATATT...

## Jira (Consulta de Tickets)
JIRA_URL=https://tu-dominio.atlassian.net
JIRA_USERNAME=tu-email@dominio.com
JIRA_API_TOKEN=tu-api-token
# Keys de proyectos a los que el agente tiene permiso de acceder
JIRA_ALLOWED_PROJECTS=["SOP", "IT", "PROJ"]

## Jira Service Management (Gestión de Clientes y OAuth 2.0)
JSM_CLOUD_ID=tu-cloud-id
JSM_CLIENT_ID=tu-oauth-client-id
JSM_CLIENT_SECRET=tu-oauth-client-secret
JSM_INITIAL_REFRESH_TOKEN=tu-refresh-token-obtenido-con-script
# Archivo donde se guardará la rotación de tokens (opcional)
# JSM_TOKEN_FILE=data/jsm_tokens.json

# --- Seguridad y Webhooks ---
API_KEY=clave-secreta-para-microservicio
TWILIO_AUTH_TOKEN=tu_auth_token_de_twilio

# --- Almacenamiento ---
# Directorio para la base de datos vectorial (opcional)
# CHROMA_PERSIST_DIRECTORY=data/chroma

